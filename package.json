{
  "name": "javascript-practice",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node src/scripts/build.mjs",
    "dev": "node src/scripts/serve.mjs",
    "test": "node --test src/tests/*.test.mjs",
    "check:browser": "node src/scripts/check-terminal-ui.mjs && node src/scripts/check-render-grading.mjs",
    "check:grading": "node src/scripts/grading-audit.mjs",
    "push": "npm run build && clasp push",
    "deploy": "npm run build && clasp push && clasp deploy",
    "check:terminal": "node src/scripts/check-terminal-ui.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "1.2.5",
    "@radix-ui/react-accordion": "1.3.1",
    "framer-motion": "11.18.2",
    "linkedom": "^0.18.13",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-resizable-panels": "2.1.9"
  },
  "devDependencies": {
    "@google/clasp": "^3.4.1",
    "@tutorialkit/theme": "1.6.0",
    "@unocss/reset": "0.59.4",
    "esbuild": "^0.28.2",
    "unocss": "0.59.4",
    "yaml": "^2.9.1"
  }
}
